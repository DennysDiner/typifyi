# Copy to /etc/rti-tracker.env (or export) — never commit real values.
RTI_CONTACT_EMAIL=you@example.org          # goes into the User-Agent so site operators can contact you
RTI_DATA_DIR=/opt/tas-rti-tracker/data      # DB + archive location (default: ./data)
ANTHROPIC_API_KEY=                          # for `rti metadata` (LLM metadata pass)
RTI_LLM_MODEL=claude-sonnet-5
# alerts: set the channel(s) you want
RTI_NTFY_URL=https://ntfy.sh/your-private-topic
RTI_NTFY_TOKEN=
RTI_SMTP_HOST=
RTI_SMTP_PORT=587
RTI_SMTP_USER=
RTI_SMTP_PASSWORD=
RTI_ALERT_EMAIL_TO=
# web UI basic auth (leave unset for no auth on localhost-only)
RTI_WEB_USER=kurt
RTI_WEB_PASSWORD=
